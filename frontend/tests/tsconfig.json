{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": ".build",
    "rootDir": "../src/lib",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "../src/lib/workspace-manager.ts",
    "../src/lib/workspace-sync.ts",
    "../src/lib/workspace-save-queue.ts"
  ]
}
