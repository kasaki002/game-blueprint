 # === App ===
 DEBUG=false
 CORS_ORIGINS=["http://localhost:3000"]
 
 # === PostgreSQL ===
 # Host-run backend connects to the Compose-published host port (15432).
# Containers use postgres:5432 via docker-compose.yml overrides.
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:15432/game_blueprint
 
 # === MongoDB ===
 MONGO_DSN=mongodb://localhost:27017
 MONGO_DB=game_blueprint
 
 # === Vector Store ===
 VECTOR_STORE=pgvector
 PINECONE_API_KEY=
 PINECONE_ENV=
 PINECONE_INDEX=
 
 # === LLM ===
 LLM_PROVIDER=openai
 OPENAI_API_KEY=
 OPENAI_MODEL=gpt-4o
 ANTHROPIC_API_KEY=
 ANTHROPIC_MODEL=claude-sonnet-4-20250514
 
 # === RAG ===
 EMBEDDING_MODEL=text-embedding-3-small
 CHUNK_SIZE=512
 CHUNK_OVERLAP=64
TOP_K=5
 
 # === Redis ===
REDIS_DSN=redis://localhost:6379/0

# === Crawler ===
CRAWL_TIMEOUT=30
CRAWL_DELAY=1.0
CRAWL_MAX_RESULTS=3
CRAWL_MAX_RETRIES=3
CRAWL_JOB_TTL=86400
CRAWLER_USER_AGENT=GameBlueprint/0.1 (+https://localhost)
BROWSER_CRAWL_ENABLED=true
BROWSER_CRAWL_CONCURRENCY=2
BROWSER_CRAWL_TIMEOUT=30
PROXY_POOL=[]
